DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-me
DB_DRIVER=org.postgresql.Driver
# Generate a BCrypt hash; do not use a plaintext password here.
SURVEY_ADMIN_USERNAME=admin
SURVEY_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SURVEY_ADMIN_COOKIE_SECURE=false
SURVEY_ADMIN_COOKIE_SAME_SITE=Lax
SURVEY_PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
